{
  "version": 2,
  "builds": [
    {
      "src": "omnirouter_hbos.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["media/**"]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "omnirouter_hbos.js"
    }
  ],
  "crons": [
    {
      "path": "/v1/health",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/v1/recursos/verificar",
      "schedule": "0 1 * * *"
    }
  ]
}